NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:LocalTestPassword123@127.0.0.1:5432/grow_bangladesh
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
RUN_DEMO_SEED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-development-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=10
EMAIL_VERIFY_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
ALLOW_DEV_USER_HEADER=false
DEMO_SEED_PASSWORD=change-me-strong-seed-password

# OTP plaintext preview in API responses (phone OTP only; email codes never previewed).
ALLOW_OTP_PREVIEW=false
OTP_PREVIEW_ALLOWLIST=

# Staging invite gate (also enabled when NODE_ENV=staging)
STAGING_ACCESS_REQUIRED=false
STAGING_INVITE_CODE=

# Payment gateways must stay disabled on private staging
LIVE_PAYMENT_GATEWAYS=false
BKASH_GATEWAY_ENABLED=false
SSLCOMMERZ_ENABLED=false

# In-memory auth rate limits (single replica)
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15M=20
RATE_LIMIT_OTP_VERIFY_PER_15M=10
RATE_LIMIT_OTP_REQUEST_PER_15M=10
RATE_LIMIT_EMAIL_VERIFY_PER_15M=10
RATE_LIMIT_EMAIL_RESEND_PER_HOUR=3

# Public web URL used in Verify Email links (no trailing slash)
APP_PUBLIC_URL=http://localhost:3000

# Email delivery (SMTP). Leave SMTP_HOST empty to use in-memory adapter locally.
# EMAIL_ADAPTER=memory|smtp
EMAIL_ADAPTER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Invest in Bangladesh
SMTP_REPLY_TO=support@investinbd.net

# App-level AES-256-GCM key for bank account/routing/MFS (32-byte base64). Never commit real values.
FIELD_ENCRYPTION_KEY=
